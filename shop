      .campaign-grid.women-grid .micro-stack:nth-child(2) { grid-row: 2; }
      .product-area { padding: 29px 12px 36px; }
      .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .final-editorial, .final-copy { min-height: 390px; }
      .footer-grid { grid-template-columns: 1fr; gap: 32px; }
      .mobile-menu { display: block; }
    }
