    .socials a { color: inherit; }
    .footer-status { min-height: 15px; margin: 9px 0 0; font-size: 8px; }

    .drawer { transform: translateX(102%); transition: transform .32s ease; }
    .drawer.open { transform: translateX(0); }
    .backdrop { opacity: 0; pointer-events: none; transition: opacity .24s ease; }
    .backdrop.open { opacity: 1; pointer-events: auto; }
    .toast { opacity: 0; pointer-events: none; transform: translate(-50%, 12px); transition: opacity .2s, transform .2s; }
    .toast.show { opacity: 1; transform: translate(-50%, 0); }

    @media (max-width: 860px) {
