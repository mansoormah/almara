      gap: 6px;
      margin-top: 7px;
      height: 430px;
    }
    .campaign-grid.women-grid { grid-template-columns: .53fr .53fr 1.28fr; }

    .campaign-card, .micro-card {
      position: relative;
      overflow: hidden;
      min-width: 0;
      background: #b9a895;
    }
    .campaign-card img, .micro-card img { position: absolute; inset: 0; transition: transform .65s ease; }
    .campaign-card:hover img, .micro-card:hover img { transform: scale(1.035); }

    .micro-stack {
      display: grid;
      grid-template-rows: 1fr 1fr;
      gap: 6px;
      min-width: 0;
    }

    .card-overlay {
      position: absolute;
