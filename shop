      .brand-panel { grid-column: 1 / -1; min-height: auto; padding: 48px 25px; }
      .brand-panel-inner { width: min(100%, 500px); }
      .campaign-grid, .campaign-grid.women-grid { height: 380px; }
      .product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px 12px; }
